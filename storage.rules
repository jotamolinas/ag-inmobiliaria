rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Fotos de terrenos: Lectura pública (para visitantes web), escritura para usuarios autenticados
    match /fotos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Videos de terrenos: Lectura pública (para el reproductor), escritura para usuarios autenticados
    match /videos_propiedades/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Videos principales de la inmobiliaria
    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regla de seguridad por defecto para otros archivos
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
